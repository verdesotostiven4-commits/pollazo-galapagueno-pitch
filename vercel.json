{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/feria/edicion",
      "destination": "/editor.html"
    },
    {
      "source": "/feria.html/edicion",
      "destination": "/editor.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/editor.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
